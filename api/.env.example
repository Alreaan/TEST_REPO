# Copy to .env and fill in your SQL Server details
PORT=3000

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=QuotesDb
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd

# true for Azure SQL; false is typical for a local server
DB_ENCRYPT=false
# true for local/dev servers with self-signed certificates
DB_TRUST_SERVER_CERTIFICATE=true
